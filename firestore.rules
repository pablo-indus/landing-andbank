rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Denegar todo por defecto. Cualquier coleccion no listada abajo queda bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }

    // Datos mensuales del dashboard.
    // Lectura publica: la landing es de uso interno y los datos no son confidenciales
    // dentro de la empresa, por lo que no exigimos login para consultarla.
    // Escritura: solo usuarios autenticados (panel de administracion).
    // Este es el unico control real de acceso: la contrasena del formulario es
    // solo una capa de interfaz y no protege nada por si sola.
    match /monthly_reports/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
