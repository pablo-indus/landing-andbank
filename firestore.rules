rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Denegar todo por defecto. Cualquier coleccion no listada abajo queda bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }

    // Datos mensuales del dashboard.
    // Lectura publica: la landing es de uso interno y los datos no son confidenciales
    // dentro de la empresa, por lo que no exigimos login para consultarla.
    // Escritura: solo usuarios autenticados (panel de administracion).
    // Este es el unico control real de acceso: la contrasena del formulario es
    // solo una capa de interfaz y no protege nada por si sola.
    match /monthly_reports/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Copias automaticas que se hacen antes de cada subida.
    // Solo las ve y las restaura quien puede subir, asi que aqui no hay lectura
    // publica: no aportaria nada a la web y expondria versiones anteriores de
    // los datos que alguien ya decidio sustituir.
    match /backups/{backupId} {
      allow read, write: if request.auth != null;

      match /docs/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // Contador de uso: visitas y descargas de informe.
    // Tiene que poder escribir cualquiera, porque quien visita la web no inicia
    // sesion. Se limita a lo que es: crear o actualizar el documento del mes, y
    // nada mas. No se puede borrar, y no guarda ningun dato de quien visita.
    match /usage_stats/{month} {
      allow read: if request.auth != null;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}
