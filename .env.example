# Configuracion de Firebase (proyecto que contiene la coleccion 'monthly_reports').
# Todas las variables VITE_* se incluyen en el bundle y son visibles para cualquiera
# que abra el codigo fuente en el navegador. Eso es normal y esperado en Firebase:
# la seguridad real la imponen las reglas de firestore.rules, no estas claves.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cuenta de administracion creada en Firebase Authentication (Email/Password).
# Al rellenarla, el equipo solo tiene que escribir la contrasena para subir informes.
# Si se deja vacia, el panel pedira tambien el correo.
# La CONTRASENA nunca se guarda aqui: vive solo en Firebase Authentication.
VITE_ADMIN_EMAIL=
